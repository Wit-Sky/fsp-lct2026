# Скопируйте в .env (не коммитится). Все переменные необязательны — значения по умолчанию подходят для демо.
DATABASE_URL=postgresql+asyncpg://fsp:fsp@db:5432/fsp
JWT_SECRET=change-me-to-a-long-random-string-32-bytes-min
JWT_TTL_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://localhost
FRONTEND_URL=http://localhost
DATA_DIR=/data

# Кулдаун смены грейда: 30 дней; DEMO_COOLDOWN_MIN>0 — вместо этого N минут (для жюри)
COOLDOWN_DAYS=30
DEMO_COOLDOWN_MIN=2
TEST_TIME_LIMIT_MIN=5
ITEM_TIME_LIMIT_SEC=90

# DEMO_MODE=1 — код подтверждения email возвращается в ответе /auth/register (имитация письма)
DEMO_MODE=1
SEED_ON_START=1

# FSP ID: mock — встроенная имитация; oidc — настоящий Keycloak
FSP_MODE=mock
FSP_ISSUER=http://localhost/api/auth/fsp/mock
FSP_CLIENT_ID=fsp-talent
FSP_CLIENT_SECRET=
FSP_REDIRECT_URI=http://localhost/api/auth/fsp/callback
