# Скопировать в .env и поменять на стенде
PUBLIC_URL=http://localhost          # внешний адрес стенда, например https://fsp.example.ru
HTTP_PORT=80
POSTGRES_PASSWORD=fsp
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes
DEMO_MODE=1                          # код подтверждения email показывается в ответе (имитация письма)
DEMO_COOLDOWN_MIN=2                  # кулдаун в минутах для демо; 0 — 30 дней
